# ────────────────────────────────────────────────────────────────────
# ClouthesShop Environment Variables
# Copy this file to .env and fill in production values
# ────────────────────────────────────────────────────────────────────

# JWT (MUST be changed in production - minimum 64 characters)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_SECRET_KEY_FOR_PRODUCTION_AT_LEAST_64_CHARS

# Stripe (obtain from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Email (SMTP settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
